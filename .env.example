# Copy to .env and fill in. NEVER commit .env
# Kaggle API credentials: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional: only needed for gated Hugging Face models.
# The selected model (Qwen/Qwen3-VL-4B-Instruct) is ungated, so this is NOT required.
HF_TOKEN=
